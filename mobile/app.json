{
  "expo": {
    "name": "BuloqWater",
    "slug": "buloqwater",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "buloqwater",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.buloqwater.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0EA5E9"
      },
      "package": "uz.buloqwater.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
